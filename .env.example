# Copy to .env and fill in your key. (.env is gitignored)

# Option A - OpenAI directly (configs/base.yaml: base_url = https://api.openai.com/v1)
OPENAI_API_KEY=sk-...

# Option B - OpenRouter
# configs/base.yaml: base_url = https://openrouter.ai/api/v1
#                    model    = openai/text-embedding-3-small
OPENROUTER_API_KEY=sk-or-v1-...

# Option C - NVD CVE API (HW5). Optional: without a key NVD serves 5
# requests per 30 seconds, with one 50. Free at
# https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=
